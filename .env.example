# Proveedor de LLM. Por ahora solo "gemini" está implementado en config.py,
# pero la idea es poder agregar otros (openai, etc.) sin tocar el agente.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Usadas por scheduler.py/telegram_notifier.py (V3.2) para enviar
# recordatorios por Telegram. TELEGRAM_CHAT_ID es el chat al que el bot
# te manda los mensajes (conseguilo hablándole al bot y consultando
# getUpdates, o con un bot tipo @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
